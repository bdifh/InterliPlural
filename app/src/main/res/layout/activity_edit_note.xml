<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:soundEffectsEnabled="false"
    android:fitsSystemWindows="true"
    android:background="#FFFDF0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnEditNoteBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                app:icon="@drawable/abc_ic_ab_back_material"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:text="" />
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flowButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flow_maxElementsWrap="2"
                app:flow_wrapMode="aligned"
                app:flow_horizontalGap="8dp"
                app:flow_verticalGap="8dp"
                app:flow_horizontalStyle="spread"
                app:constraint_referenced_ids="btnReply,btnMarkRead,btnEditNoteMode,btnExportNotePopup,btnImportNote,btnDeleteNote,btnSaveNote"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnReply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_revert"
                app:iconGravity="textStart"
                android:text="@string/action_reply"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnMarkRead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconGravity="textStart"
                android:text="@string/action_mark_read"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnEditNoteMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconGravity="textStart"
                android:text="@string/edit"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnExportNotePopup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_share"
                app:iconGravity="textStart"
                android:text="@string/action_export" />

            <Button
                android:id="@+id/btnImportNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_add"
                app:iconGravity="textStart"
                android:text="@string/action_import_note" />

            <Button
                android:id="@+id/btnDeleteNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconGravity="textStart"
                android:text="@string/delete"
                android:textColor="#FF0000"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSaveNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                android:text="@string/save" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_note_title"
                    app:boxBackgroundMode="none"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editNoteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:background="@null"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/labelLinkedMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_linked_members"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLinkMembers"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_link_members"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/linkedMembersText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/labelBundle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_bundle"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSelectBundle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_bundle"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/selectedBundleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:alpha="0.7" />

                <CheckBox
                    android:id="@+id/cbProfileOnlyNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_profile_only" />

                <TextView
                    android:id="@+id/labelLinkedTodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_linked_todo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLinkTodo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_link_todo_list"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/linkedTodoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:alpha="0.7" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/hint_note_content"
                    app:boxBackgroundMode="none"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editNoteContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="200dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:background="@null"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/markdownNoteView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:visibility="gone" />

                <!-- Media Embed Container -->
                <LinearLayout
                    android:id="@+id/mediaEmbedContainerNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>