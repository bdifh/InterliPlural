<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Day Separator -->
    <LinearLayout
        android:id="@+id/daySeparator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">
        <View android:id="@+id/lineLeft" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#CCCCCC" />
        <TextView android:id="@+id/tvDayHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" android:textStyle="bold" android:textColor="#666666" />
        <View android:id="@+id/lineRight" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#CCCCCC" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:id="@+id/layoutBubbleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Like Left -->
            <LinearLayout
                android:id="@+id/btnLikeChatLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvLikesChatLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:layout_marginEnd="2dp" />
                <ImageView
                    android:id="@+id/ivLikeIconChatLeft"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/btn_star_big_off" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/layoutBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Identity Line Top -->
                    <View
                        android:id="@+id/viewColorLineTop"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Identity Line Side Left -->
                        <View
                            android:id="@+id/viewColorLineSide"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutBubbleContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:id="@+id/layoutReplyContext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="#15000000"
                                android:padding="6dp"
                                android:layout_marginBottom="4dp"
                                android:visibility="gone">
                                <View android:id="@+id/viewReplyContextIndicator" android:layout_width="2dp" android:layout_height="match_parent" android:background="#88000000" android:layout_marginEnd="6dp" />
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                                    <TextView android:id="@+id/tvReplyContextSender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="11sp" />
                                    <TextView android:id="@+id/tvReplyContextContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivChatMessageImage"
                                android:layout_width="200dp"
                                android:layout_height="200dp"
                                android:scaleType="centerCrop"
                                android:layout_marginBottom="4dp"
                                app:shapeAppearanceOverlay="@style/RoundedImage"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#000000"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <LinearLayout android:id="@+id/mediaEmbedContainerChat" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />

                            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="2dp" android:alpha="0.6" android:textColor="#000000" android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Identity Line Side Right -->
                        <View
                            android:id="@+id/viewColorLineSideRight"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Like Right -->
            <LinearLayout
                android:id="@+id/btnLikeChatRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/ivLikeIconChatRight"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/btn_star_big_off" />
                <TextView
                    android:id="@+id/tvLikesChatRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
