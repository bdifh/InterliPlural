<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_day_root"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:orientation="vertical"
    android:padding="1dp"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tvWidgetDayNumber"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:gravity="center"
        android:text="1"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetEvent1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="3dp"
        android:paddingEnd="1dp"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWidgetEvent2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="3dp"
        android:paddingEnd="1dp"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWidgetEvent3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="3dp"
        android:paddingEnd="1dp"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWidgetEvent4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="3dp"
        android:paddingEnd="1dp"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWidgetEvent5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="3dp"
        android:paddingEnd="1dp"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        android:textColor="#FFFFFF" />

</LinearLayout>