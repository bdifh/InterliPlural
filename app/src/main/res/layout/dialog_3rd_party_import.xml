<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp">

        <!-- Simply Plural Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_sp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSpToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sp_token"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:scrollHorizontally="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportSp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportSpAvatars"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simply Plural Avatars (ZIP)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportSpJson"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simply Plural JSON"
            android:layout_marginBottom="24dp" />

        <!-- PluralKit Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_pk"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPkToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_pk_token"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:scrollHorizontally="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportPk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportPkJson"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PluralKit JSON"
            android:layout_marginBottom="8dp" />

        <!-- PluralSpace Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PluralSpace"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportPs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_ps" />

        <!-- Plural Star Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plural Star"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportPluralStar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Plural Star (ZIP)" />

        <!-- Hivemind Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hivemind (Multiplicity)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportHm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_hm" />

        <!-- Ampresand Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ampersand"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportAmpersand"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ampersand Json (Base64)"
            android:layout_marginBottom="8dp" />

        <!-- OpenPlural Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenPlural"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportOpenPlural"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenPlural (.json)"
            android:layout_marginBottom="8dp" />

        <!-- Daylio Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_daylio"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportDaylio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import" />

    </LinearLayout>
</ScrollView>
