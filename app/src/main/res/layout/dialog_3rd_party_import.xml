<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- PluralKit API Token Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_pk"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPkToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_pk_token"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:scrollHorizontally="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportPk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import"
            android:layout_marginBottom="24dp" />

        <!-- Third Party Plural App File Import Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_3rd_party_file_import"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/desc_3rd_party_file_import"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImport3rdPartyFile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_file"
            android:layout_marginBottom="24dp" />

        <!-- Daylio Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import_daylio"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportDaylio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_import" />

    </LinearLayout>
</ScrollView>