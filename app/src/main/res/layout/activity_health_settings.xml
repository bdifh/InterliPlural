<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/health_settings_title" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/health_settings_switches"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="12dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHydration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_hydration"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEaten"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_eaten"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNutrition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_nutrition"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_energy"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchRest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_rest"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSensations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_sensations"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCustomSliders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_custom_sliders"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCustomCounters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_custom_counters"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMedication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_medication"
                    android:padding="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_weight"
                    android:padding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCustomCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/dialog_add_counter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCustomSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dialog_add_slider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSensation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dialog_add_sensation" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMedication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dialog_add_medication" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/main_menu" />

</androidx.drawerlayout.widget.DrawerLayout>